@model IEnumerable<Puy_Midterm_Store.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Product Catalog</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Product</a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">No products available yet. Click <strong>Add New Product</strong> above to get started.</div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">@item.Category</span>
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted flex-grow-1">@item.Description</p>
                        <h4 class="text-primary mb-3">₱@item.Price.ToString("N2")</h4>

                        <div class="d-flex gap-2">
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <button type="submit" class="btn btn-success w-100">Add to Cart</button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>