@model IEnumerable<Puy_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Shopping Cart</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your cart is currently empty. <a asp-controller="Products" asp-action="Index">Browse products here</a>.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Price</th>
                <th style="width: 180px;">Quantity</th>
                <th>Subtotal</th>
                <th style="width: 100px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var subtotal = item.Price * item.Quantity;
                <tr>
                    <td>@item.ProductName</td>
                    <td>₱@item.Price.ToString("N2")</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                    </td>
                    <td>₱@subtotal.ToString("N2")</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light">
                <td colspan="3" class="text-end fw-bold fs-5">Grand Total:</td>
                <td colspan="2" class="fw-bold fs-5 text-success">₱@(((decimal)ViewBag.GrandTotal).ToString("N2"))</td>
            </tr>
        </tfoot>
    </table>
}